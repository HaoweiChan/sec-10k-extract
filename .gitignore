__pycache__/
*.pyc
# build-time sha injection (ADR-028): zbpack.json's build_command writes
# this into the image. NEVER committed — a checked-in sha is stale on the
# next redeploy, and its absence resolves to the honest `unknown`.
BUILD_SHA
.venv/
.env
.DS_Store
# graphify: the graph, its viewer, and the report are committed (graphify-out/).
# These are not — bulky-regenerable or machine-local.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json
